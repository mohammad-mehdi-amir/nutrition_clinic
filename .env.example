SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SMS (password reset). Console backend prints codes to the log in development.
SMS_BACKEND=apps.accounts.sms.ConsoleSMSBackend
SMS_API_KEY=
SMS_TEMPLATE=

# Payments: fake (development only) | zarinpal
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
# True = sandbox.zarinpal.com (any UUID works as merchant id). Set False in production.
ZARINPAL_SANDBOX=True
ZARINPAL_TIMEOUT=20

# --- Production ---
# DEBUG=False requires SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
# Start small; raise to 31536000 once HTTPS works everywhere.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
LOG_LEVEL=INFO
# Comma-separated emails that receive server error reports
ADMINS=

# Database: sqlite (development) | postgres (production)
DB_ENGINE=sqlite
DB_NAME=nutrition_clinic
DB_USER=nutrition_clinic
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Cache for rate limiting: locmem (single process) | database (shared by all gunicorn workers;
# run "python manage.py createcachetable" once)
CACHE_BACKEND=locmem

# Rate limiting (utils/ratelimit.py). Behind Nginx set RATELIMIT_IP_HEADER=HTTP_X_REAL_IP
# and in Nginx: proxy_set_header X-Real-IP $remote_addr;
RATELIMIT_ENABLED=True
RATELIMIT_IP_HEADER=
